{
  "app": {
    "id": "order-desk",
    "name": "注文受付",
    "tables": [
      {
        "id": "orders",
        "name": "注文",
        "fields": [
          { "id": "title", "name": "件名", "type": "text", "required": true },
          { "id": "category", "name": "種類", "type": "select", "options": ["食品", "雑貨"] }
        ]
      }
    ],
    "views": [
      {
        "id": "order-form",
        "type": "form",
        "table": "orders",
        "fields": ["title", "category"],
        "group_by": { "field": "category" }
      }
    ]
  }
}
