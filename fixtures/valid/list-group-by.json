{
  "app": {
    "id": "order-desk",
    "name": "注文受付",
    "tables": [
      {
        "id": "customers",
        "name": "顧客",
        "fields": [{ "id": "name", "name": "名前", "type": "text", "required": true }]
      },
      {
        "id": "orders",
        "name": "注文",
        "fields": [
          { "id": "title", "name": "件名", "type": "text", "required": true },
          { "id": "category", "name": "種類", "type": "select", "options": ["食品", "雑貨"] },
          { "id": "ordered_on", "name": "注文日", "type": "date" },
          { "id": "shipped", "name": "発送済み", "type": "boolean" },
          { "id": "customer", "name": "顧客", "type": "reference", "reference_table": "customers" }
        ]
      }
    ],
    "views": [
      {
        "id": "order-by-category",
        "type": "list_view",
        "table": "orders",
        "columns": ["title", "category", "ordered_on"],
        "group_by": { "field": "category" }
      },
      {
        "id": "order-by-month",
        "type": "list_view",
        "table": "orders",
        "columns": ["title", "ordered_on"],
        "sort": { "field": "title", "order": "asc" },
        "group_by": { "field": "ordered_on", "granularity": "month" }
      },
      {
        "id": "order-by-shipped",
        "type": "list_view",
        "table": "orders",
        "columns": ["title", "shipped", "customer"],
        "preset_list_shape": "card",
        "group_by": { "field": "shipped" }
      },
      {
        "id": "order-by-customer",
        "type": "list_view",
        "table": "orders",
        "columns": ["title", "customer"],
        "group_by": { "field": "customer" }
      }
    ]
  }
}
