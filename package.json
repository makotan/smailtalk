{
  "name": "smailtalk",
  "version": "0.4.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "module": "src/kernel/index.ts",
  "types": "src/kernel/index.ts",
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "validate": "bun run src/cli/validate.ts",
    "requirements-doc": "bun run src/cli/requirements-doc.ts",
    "server": "bun run src/server/index.ts",
    "server:runner": "ST_SERVER_PROFILE=runner bun run src/server/index.ts",
    "mcp": "bun run src/mcp/index.ts",
    "mcp:http": "bun run src/mcp/http-entry.ts",
    "dev:server": "bun --watch run src/server/index.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "build:web": "vite build --config web/vite.config.ts",
    "build:runner": "vite build --config web/vite.config.ts --mode runner",
    "preview:web": "vite preview --config web/vite.config.ts",
    "test:e2e": "bun run build:web && GP_RUNNER_APP_ID=runner-e2e bun run build:runner && mv web/runner/dist/runner.html web/runner/dist/index.html && playwright test --config web/e2e/playwright.config.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.7",
    "@happy-dom/global-registrator": "20.11.2",
    "@nivo/bar": "0.99.0",
    "@nivo/line": "0.99.0",
    "@playwright/test": "1.62.1",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.2",
    "@types/bun": "^1.3.14",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "happy-dom": "20.11.2",
    "typescript": "^7.0.2",
    "vite": "8.2.1"
  },
  "dependencies": {
    "@base-ui-components/react": "1.0.0-rc.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@simplewebauthn/browser": "^13.3.0",
    "@simplewebauthn/server": "^13.3.2",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "hono": "4.13.1",
    "lucide-react": "1.30.0",
    "quickjs-emscripten": "^0.32.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "3.6.0",
    "tailwindcss": "4.3.3",
    "zod": "^4.4.3"
  }
}
